{
  "name": "chernivtsi-city-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:build": "python3 scripts/build_seed.py",
    "seed:local": "wrangler d1 execute chernivtsi-city --local --file=seed/seed.sql",
    "seed:remote": "wrangler d1 execute chernivtsi-city --remote --file=seed/seed.sql"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.32.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261031.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  }
}
